# ====================================================================
# SPENDSENSE ENVIRONMENT CONFIGURATION
# ====================================================================
# SpendSense works completely offline in Local Mode out-of-the-box.
# To enable cloud synchronization with Supabase, copy this file to `.env`
# and provide your Supabase project credentials.

# Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase Anon Public Key (safe for browser client with RLS)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
